diff --git a/tasklist/tasks.py b/tasklist/tasks.py
index 966aeb4..273cd61 100644
--- a/tasklist/tasks.py
+++ b/tasklist/tasks.py
@@ -15,9 +15,11 @@ def list_tasks(tasks):
     return [dict(t) for t in tasks]
 
 
-def complete_task(tasks, task_id):
+def finish_task(tasks, task_id):
     for task in tasks:
         if task["id"] == task_id:
+            if task["done"]:
+                raise ValueError("already complete")
             task["done"] = True
             return task
     raise KeyError(task_id)
